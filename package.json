{
  "name": "commitsense-vscode-ext",
  "displayName": "CommitSense",
  "description": "Generate meaningul Git commit messages based on staged changes.",
  "version": "1.1.0",
  "publisher": "harshrajeshnaikdhure",
  "scripts": {
    "test:unit":        "node tests/unit/analyzeDiff.test.js",
    "test:integration": "node tests/integration/integration.test.js",
    "test":             "node tests/unit/analyzeDiff.test.js && node tests/integration/integration.test.js"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "commit",
    "conventional commits"
  ],
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/unusual-me/CommitSense.git"
  },
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commitSense.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "CommitSense",
        "icon": "$(git-commit)"
      }
    ],
    "keybindings": [
      {
        "command": "commitSense.generateCommitMessage",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus || scmFocus"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitSense.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "CommitSense",
      "properties": {
        "commitSense.confirmCommit": {
          "type": "boolean",
          "default": true,
          "description": "Ask confirmation before committing."
        },
        "commitSense.enablePushPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Prompt to push after a successful commit."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "18.x"
  }
}
